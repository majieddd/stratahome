<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Strata UI kit (serve/web/components.css) as WPF styles. Colours come from the theme dictionary (StBg, StSurface ...). -->

  <!-- ================================================================ cards -->
  <Style x:Key="StCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource StSurface}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="Padding" Value="20"/>
    <Setter Property="Effect">
      <Setter.Value><DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="8" ShadowDepth="2" Direction="270"/></Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ buttons -->
  <Style x:Key="StBtnBase" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontFamily" Value="{DynamicResource StFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Height" Value="42"/>
    <Setter Property="Padding" Value="18,0"/>
    <Setter Property="Foreground" Value="{DynamicResource StInk}"/>
  </Style>

  <Style x:Key="StBtnPrimary" TargetType="Button" BasedOn="{StaticResource StBtnBase}">
    <Setter Property="Foreground" Value="{DynamicResource StAccentInk}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{DynamicResource StAccent}" CornerRadius="14" Padding="{TemplateBinding Padding}">
            <Border.Effect><DropShadowEffect Color="#10B981" Opacity="0.24" BlurRadius="16" ShadowDepth="6" Direction="270"/></Border.Effect>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource StAccentHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="StBtnSecondary" TargetType="Button" BasedOn="{StaticResource StBtnBase}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource StLine}" BorderThickness="1.5" CornerRadius="14" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource StSurface2}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="StBtnDanger" TargetType="Button" BasedOn="{StaticResource StBtnBase}">
    <Setter Property="Foreground" Value="{DynamicResource StDangerText}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{DynamicResource StDangerTint}" CornerRadius="14" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="StBtnIcon" TargetType="Button" BasedOn="{StaticResource StBtnBase}">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource StInkMuted}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" CornerRadius="10">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource StSurface2}"/>
              <Setter Property="Foreground" Value="{DynamicResource StInk}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- the small icon buttons on a dark code block -->
  <Style x:Key="StBtnIconOnCode" TargetType="Button" BasedOn="{StaticResource StBtnBase}">
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="#9AA3AB"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ tabs (the header's segmented control) -->
  <Style x:Key="StTab" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontFamily" Value="{DynamicResource StFontMedium}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource StInkMuted}"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="Transparent" CornerRadius="10" Padding="14,0">
            <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource StInk}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource StSurface}"/>
              <Setter Property="Foreground" Value="{DynamicResource StInk}"/>
              <Setter Property="FontFamily" Value="{DynamicResource StFont}"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter TargetName="bd" Property="Effect">
                <Setter.Value><DropShadowEffect Color="#000000" Opacity="0.07" BlurRadius="5" ShadowDepth="1" Direction="270"/></Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ segmented control (Thinking: Off / Low / Medium / High) -->
  <Style x:Key="StSeg" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontFamily" Value="{DynamicResource StFontMedium}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource StInkMuted}"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource StSurface}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource StLineSoft}"/>
              <Setter Property="Foreground" Value="{DynamicResource StInk}"/>
              <Setter Property="FontFamily" Value="{DynamicResource StFont}"/>
              <Setter Property="FontWeight" Value="Bold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ toggle switch (40 x 24) -->
  <Style x:Key="StToggle" TargetType="ToggleButton">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid>
            <Border x:Name="track" CornerRadius="12" Background="{DynamicResource StLine}"/>
            <Ellipse x:Name="knob" Width="18" Height="18" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0">
              <Ellipse.Effect><DropShadowEffect Color="#000000" Opacity="0.2" BlurRadius="2" ShadowDepth="1" Direction="270"/></Ellipse.Effect>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{DynamicResource StAccent}"/>
              <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ text boxes -->
  <Style x:Key="StInput" TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="FontFamily" Value="{DynamicResource StFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource StInk}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource StInk}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource StFocus}"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{DynamicResource StSurface}" BorderBrush="{DynamicResource StLine}" BorderThickness="1.5" CornerRadius="14">
            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource StFocus}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.55"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="StPasswordBox" TargetType="PasswordBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="FontFamily" Value="{DynamicResource StFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource StInk}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource StInk}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource StFocus}"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="bd" Background="{DynamicResource StSurface}" BorderBrush="{DynamicResource StLine}" BorderThickness="1.5" CornerRadius="14">
            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource StFocus}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- the message box in the composer: no border of its own -->
  <Style x:Key="StComposerBox" TargetType="TextBox">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="FontFamily" Value="{DynamicResource StFont}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="{DynamicResource StInk}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource StInk}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource StFocus}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" Focusable="False" Background="Transparent"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ slim scroll bars -->
  <Style x:Key="StScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="StScrollThumb" TargetType="Thumb">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="th" Margin="2" CornerRadius="4" Background="{DynamicResource StLine}"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="th" Property="Background" Value="{DynamicResource StInkMuted}"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="th" Property="Background" Value="{DynamicResource StInkMuted}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource StScrollPage}"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource StScrollPage}"/></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource StScrollThumb}"/></Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Height" Value="12"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track">
                  <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource StScrollPage}"/></Track.DecreaseRepeatButton>
                  <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource StScrollPage}"/></Track.IncreaseRepeatButton>
                  <Track.Thumb><Thumb Style="{StaticResource StScrollThumb}"/></Track.Thumb>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ================================================================ slider -->
  <Style x:Key="StSliderFill" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton"><Border Height="6" CornerRadius="3" Background="{DynamicResource StAccent}" VerticalAlignment="Center"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="StSliderRest" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="StSliderThumb" TargetType="Thumb">
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Ellipse Width="18" Height="18" Fill="{DynamicResource StAccent}" Stroke="{DynamicResource StSurface}" StrokeThickness="2">
            <Ellipse.Effect><DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="3" ShadowDepth="1" Direction="270"/></Ellipse.Effect>
          </Ellipse>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="StSlider" TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid>
            <Border Height="6" CornerRadius="3" Background="{DynamicResource StSurface2}" BorderBrush="{DynamicResource StLineSoft}" BorderThickness="1" VerticalAlignment="Center"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource StSliderFill}"/></Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource StSliderRest}"/></Track.IncreaseRepeatButton>
              <Track.Thumb><Thumb Style="{StaticResource StSliderThumb}"/></Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================================================================ check box / radio rows (Server tab) -->
  <Style x:Key="StRadioRow" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontFamily" Value="{DynamicResource StFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource StInkSoft}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="bd" Background="Transparent" BorderBrush="{DynamicResource StLine}" BorderThickness="1.5" CornerRadius="14" Padding="14,10">
            <StackPanel Orientation="Horizontal">
              <Grid Width="18" Height="18" VerticalAlignment="Center">
                <Ellipse x:Name="ring" Stroke="{DynamicResource StLine}" StrokeThickness="1.5" Fill="Transparent"/>
                <Ellipse x:Name="dot" Width="8" Height="8" Fill="{DynamicResource StAccent}" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False"/>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource StSurface2}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource StAccent}"/>
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource StAccentTint}"/>
              <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource StAccent}"/>
              <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{DynamicResource StInk}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="{DynamicResource StSurface}"/>
    <Setter Property="Foreground" Value="{DynamicResource StInk}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource StLine}"/>
    <Setter Property="FontFamily" Value="{DynamicResource StFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="10,6"/>
  </Style>
</ResourceDictionary>

